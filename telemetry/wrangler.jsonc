{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "neoomsi-performance-reports",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-04",
  "workers_dev": false,
  "routes": [{ "pattern": "telemetry.neoomsi.com", "custom_domain": true }],
  "d1_databases": [{
    "binding": "REPORTS",
    "database_name": "neoomsi-performance-reports",
    "database_id": "9b134513-13fb-4aa1-bf5d-08bd303f8164",
    "migrations_dir": "migrations"
  }],
  "ratelimits": [{
    "name": "RATE_LIMITER",
    "namespace_id": "1001",
    "simple": { "limit": 30, "period": 60 }
  }],
  "triggers": { "crons": ["17 3 * * *"] }
}
